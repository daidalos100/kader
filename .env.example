# Server-side Supabase project URL
SUPABASE_URL=

# Server-only privileged key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional public key for future browser-side Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Current transitional trainer allowlist.
# JSON array: [{"email":"trainer@example.org","name":"Name","role":"trainer"}]
TRAINER_ACCESS_JSON=

# Long random secret for signing trainer session cookies.
TRAINER_SESSION_SECRET=

# Legacy PIN fallback only. Do not use for new platform authentication.
EDIT_PIN=
